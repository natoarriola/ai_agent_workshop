#!/usr/bin/env python3
"""mytools -- a small reimplementation of a subset of bedtools.

Real bedtools is the oracle: if our output differs from it on the same input,
we are wrong. See SPEC.md and tests/README.md.
"""

import sys
from collections.abc import Iterator
from typing import NamedTuple, TextIO

VERSION = "0.1.0"

USAGE = """\
usage: mytools <subcommand> [options]

  sort -i <file|->    sort by chrom, then start, then end
  --version           print the version and exit

`-` means stdin.
"""


class BedError(Exception):
    """Bad input data. Exit 1."""


class UsageError(Exception):
    """Bad invocation. Exit 2."""


# Skipped silently, as bedtools does.
SKIP_PREFIXES = ("#", "track", "browser")


class Record(NamedTuple):
    chrom: str
    start: int
    end: int
    line: str  # the input line, verbatim, so every column survives untouched


def open_input(path: str) -> TextIO:
    if path == "-":
        return sys.stdin
    try:
        return open(path, encoding="utf-8")
    except OSError as exc:
        raise UsageError(f"cannot read {path}: {exc.strerror}") from exc


def read_bed(stream: TextIO, source: str) -> Iterator[Record]:
    """Parse BED3-BED6 records, raising BedError on anything malformed.

    The line is carried through verbatim rather than rebuilt from the parsed
    fields, so every column we do not touch survives byte-identical.
    """
    n_fields = None
    for lineno, raw in enumerate(stream, 1):
        line = raw.rstrip("\n")
        if not line.strip() or line.startswith(SKIP_PREFIXES):
            continue

        fields = line.split("\t")
        if len(fields) < 3:
            raise BedError(
                f"{source}:{lineno}: fewer than 3 columns -- is it tab-delimited?"
            )
        if n_fields is None:
            n_fields = len(fields)
        elif len(fields) != n_fields:
            # bedtools refuses ragged input rather than padding it, and it is the
            # oracle: "Differing number of BED fields encountered at line: 2".
            raise BedError(
                f"{source}:{lineno}: differing number of BED fields "
                f"({len(fields)}, expected {n_fields})"
            )

        try:
            start, end = int(fields[1]), int(fields[2])
        except ValueError:
            raise BedError(f"{source}:{lineno}: non-integer start or end") from None
        if start < 0 or end < 0:
            raise BedError(f"{source}:{lineno}: negative coordinate")
        if start > end:
            raise BedError(f"{source}:{lineno}: start > end ({start} > {end})")

        yield Record(fields[0], start, end, line)


def cmd_sort(argv: list[str]) -> int:
    """sort -i <file|->

    Chromosomes order byte-wise, not naturally -- chr17 before chr7, and the
    oracle agrees. Python's sort is stable, which is what keeps features with
    identical coordinates in input order (a09 before a10 in the fixtures).
    """
    path = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "-i":
            if not args:
                raise UsageError("sort: -i requires a file")
            path = args.pop(0)
        else:
            raise UsageError(f"sort: unrecognized argument: {arg}")
    if path is None:
        raise UsageError("sort: -i is required")

    stream = open_input(path)
    try:
        # The one command allowed to hold its whole input in memory.
        records = sorted(
            read_bed(stream, path), key=lambda r: (r.chrom, r.start, r.end)
        )
    finally:
        if stream is not sys.stdin:
            stream.close()

    for record in records:
        sys.stdout.write(record.line)
        sys.stdout.write("\n")
    return 0


def widen_if_empty(start: int, end: int) -> tuple[int, int]:
    """Widen a zero-length interval by one base each way, for overlap tests only.

    This is oracle behaviour, not a guess. Real bedtools reports chr1 600 600 as
    overlapping chr1 400 600, which the strict half-open predicate rejects, and
    intersecting chr1 100 200 with a zero-length chr1 150 150 prints the region
    chr1 149 151. Both fall out of treating [x, x) as [x - 1, x + 1).

    It affects the overlap decision only. Reported coordinates are computed from
    the original values -- a zero-length -a feature still prints as [x, x).
    """
    if start == end:
        return start - 1, end + 1
    return start, end


def overlaps(a_start: int, a_end: int, b_start: int, b_end: int) -> bool:
    """True iff the two half-open intervals share at least one base.

    BED is 0-based half-open, so both comparisons are strict: bookended
    intervals (a_end == b_start) do not overlap. Every off-by-one in this
    project lives on this line.
    """
    a_start, a_end = widen_if_empty(a_start, a_end)
    b_start, b_end = widen_if_empty(b_start, b_end)
    return a_start < b_end and b_start < a_end


def within_merge_distance(prev_end: int, start: int, d: int = 0) -> bool:
    """True iff a feature starting at `start` joins a cluster ending at `prev_end`.

    merge joins features whose gap is <= d, and the gap between bookended
    features is 0 -- so they do NOT overlap but they DO merge at the default
    d of 0. Assumes sorted input, hence prev_end and start from adjacent rows.
    """
    return start - prev_end <= d


def main(argv: list[str]) -> int:
    if not argv:
        # Usage goes to stderr: stdout is data and gets piped.
        sys.stderr.write(USAGE)
        return 2

    if argv[0] in ("--version", "-version"):
        print(f"mytools {VERSION}")
        return 0

    if argv[0] in ("--help", "-h"):
        sys.stdout.write(USAGE)
        return 0

    if argv[0] == "sort":
        try:
            return cmd_sort(argv[1:])
        except BedError as exc:
            sys.stderr.write(f"mytools: {exc}\n")
            return 1
        except UsageError as exc:
            sys.stderr.write(f"mytools: {exc}\n")
            return 2
        except BrokenPipeError:
            # Downstream closed the pipe (`| head`). Not our error.
            sys.stderr.close()
            return 0

    sys.stderr.write(f"mytools: unknown subcommand: {argv[0]}\n")
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
