#!/usr/bin/env python3
"""mytools -- a small reimplementation of a subset of bedtools.

Real bedtools is the oracle: if our output differs from it on the same input,
we are wrong. See SPEC.md and tests/README.md.
"""

import sys
from bisect import bisect_left
from collections.abc import Iterator
from typing import NamedTuple, TextIO

VERSION = "0.1.0"

USAGE = """\
usage: mytools <subcommand> [options]

  sort  -i <file|->            sort by chrom, then start, then end
  merge -i <file|-> [-d N]     join features whose gap is <= N (default 0)
  intersect -a <file|-> -b <file> [-u|-v|-wa]
                               report where -a features meet -b features
  --version                    print the version and exit

`-` means stdin.
"""


class BedError(Exception):
    """Bad input data. Exit 1."""


class UsageError(Exception):
    """Bad invocation. Exit 2."""


# Skipped silently, as bedtools does.
SKIP_PREFIXES = ("#", "track", "browser")


class Record(NamedTuple):
    chrom: str
    start: int
    end: int
    line: str  # the input line, verbatim, so every column survives untouched


def open_input(path: str) -> TextIO:
    if path == "-":
        return sys.stdin
    try:
        return open(path, encoding="utf-8")
    except OSError as exc:
        raise UsageError(f"cannot read {path}: {exc.strerror}") from exc


def read_bed(stream: TextIO, source: str) -> Iterator[Record]:
    """Parse BED3-BED6 records, raising BedError on anything malformed.

    The line is carried through verbatim rather than rebuilt from the parsed
    fields, so every column we do not touch survives byte-identical.
    """
    n_fields = None
    for lineno, raw in enumerate(stream, 1):
        line = raw.rstrip("\n")
        if not line.strip() or line.startswith(SKIP_PREFIXES):
            continue

        fields = line.split("\t")
        if len(fields) < 3:
            raise BedError(
                f"{source}:{lineno}: fewer than 3 columns -- is it tab-delimited?"
            )
        if n_fields is None:
            n_fields = len(fields)
        elif len(fields) != n_fields:
            # bedtools refuses ragged input rather than padding it, and it is the
            # oracle: "Differing number of BED fields encountered at line: 2".
            raise BedError(
                f"{source}:{lineno}: differing number of BED fields "
                f"({len(fields)}, expected {n_fields})"
            )

        try:
            start, end = int(fields[1]), int(fields[2])
        except ValueError:
            raise BedError(f"{source}:{lineno}: non-integer start or end") from None
        if start < 0 or end < 0:
            raise BedError(f"{source}:{lineno}: negative coordinate")
        if start > end:
            raise BedError(f"{source}:{lineno}: start > end ({start} > {end})")

        yield Record(fields[0], start, end, line)


def take_value(args: list[str], flag: str) -> str:
    if not args:
        raise UsageError(f"{flag} requires a value")
    return args.pop(0)


def cmd_sort(argv: list[str]) -> int:
    """sort -i <file|->

    Chromosomes order byte-wise, not naturally -- chr17 before chr7, and the
    oracle agrees. Python's sort is stable, which is what keeps features with
    identical coordinates in input order (a09 before a10 in the fixtures).
    """
    path = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "-i":
            path = take_value(args, "sort: -i")
        else:
            raise UsageError(f"sort: unrecognized argument: {arg}")
    if path is None:
        raise UsageError("sort: -i is required")

    stream = open_input(path)
    try:
        # The one command allowed to hold its whole input in memory.
        records = sorted(
            read_bed(stream, path), key=lambda r: (r.chrom, r.start, r.end)
        )
    finally:
        if stream is not sys.stdin:
            stream.close()

    for record in records:
        sys.stdout.write(record.line)
        sys.stdout.write("\n")
    return 0


def widen_if_empty(start: int, end: int) -> tuple[int, int]:
    """Widen a zero-length interval by one base each way, for overlap tests only.

    This is oracle behaviour, not a guess. Real bedtools reports chr1 600 600 as
    overlapping chr1 400 600, which the strict half-open predicate rejects, and
    intersecting chr1 100 200 with a zero-length chr1 150 150 prints the region
    chr1 149 151. Both fall out of treating [x, x) as [x - 1, x + 1).

    It affects the overlap decision only. Reported coordinates are computed from
    the original values -- a zero-length -a feature still prints as [x, x).
    """
    if start == end:
        return start - 1, end + 1
    return start, end


def overlaps(a_start: int, a_end: int, b_start: int, b_end: int) -> bool:
    """True iff the two half-open intervals share at least one base.

    BED is 0-based half-open, so both comparisons are strict: bookended
    intervals (a_end == b_start) do not overlap. Every off-by-one in this
    project lives on this line.
    """
    a_start, a_end = widen_if_empty(a_start, a_end)
    b_start, b_end = widen_if_empty(b_start, b_end)
    return a_start < b_end and b_start < a_end


def within_merge_distance(prev_end: int, start: int, d: int = 0) -> bool:
    """True iff a feature starting at `start` joins a cluster ending at `prev_end`.

    merge joins features whose gap is <= d, and the gap between bookended
    features is 0 -- so they do NOT overlap but they DO merge at the default
    d of 0. Assumes sorted input, hence prev_end and start from adjacent rows.
    """
    return start - prev_end <= d


def merge_clusters(
    records: Iterator[Record], distance: int, source: str
) -> Iterator[tuple[str, int, int]]:
    """Cluster sorted records, yielding (chrom, start, end) in BED3.

    Zero-length features are widened to [x-1, x+1) and the widened coordinates
    reach the output -- chr1 0 0 beside chr1 0 10 really does print chr1 -1 10.
    The one exception is a cluster of a single feature, which prints its own
    original coordinates, so a lone chr1 500 500 is unchanged while two of them
    print chr1 499 501. Oracle behaviour, matched against bedtools on 25 cases.

    Sortedness is checked the way bedtools checks it, which is loosely: start
    order within a chromosome, and no returning to a chromosome already left.
    Descending chromosomes are not an error -- chr2 before chr1 exits 0.
    """
    seen: set[str] = set()
    chrom: str | None = None
    start = end = 0
    count = 0
    first: Record | None = None
    prev_start = 0

    def cluster() -> tuple[str, int, int]:
        assert chrom is not None and first is not None
        # A lone feature keeps its own coordinates; any widening it got was
        # only ever used to decide that nothing joined it.
        if count == 1:
            return (chrom, first.start, first.end)
        return (chrom, start, end)

    for record in records:
        wide_start, wide_end = widen_if_empty(record.start, record.end)

        if record.chrom != chrom:
            if first is not None:
                yield cluster()
            if record.chrom in seen:
                raise BedError(
                    f"{source}: unsorted input: {record.chrom} appears again at "
                    f"{record.start}; merge does not sort for you"
                )
            seen.add(record.chrom)
            chrom = record.chrom
            start, end, count, first = wide_start, wide_end, 1, record
            prev_start = record.start
            continue

        if record.start < prev_start:
            raise BedError(
                f"{source}: unsorted input: {record.chrom}:{record.start} follows "
                f"{prev_start}; merge does not sort for you"
            )
        prev_start = record.start

        if wide_start - end <= distance:
            end = max(end, wide_end)
            count += 1
        else:
            yield cluster()
            start, end, count, first = wide_start, wide_end, 1, record

    if first is not None:
        yield cluster()


def cmd_merge(argv: list[str]) -> int:
    """merge -i <file|-> [-d N]

    Features join when the gap between them is <= d. The gap between bookended
    features is 0, so they merge at the default d of 0 even though they do not
    overlap. A negative d demands that much overlap instead.
    """
    path = None
    distance = 0
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "-i":
            path = take_value(args, "merge: -i")
        elif arg == "-d":
            raw = take_value(args, "merge: -d")
            try:
                distance = int(raw)
            except ValueError:
                raise UsageError(f"merge: -d needs an integer, got {raw!r}") from None
        else:
            raise UsageError(f"merge: unrecognized argument: {arg}")
    if path is None:
        raise UsageError("merge: -i is required")

    stream = open_input(path)
    try:
        # Streaming: one cluster at a time, never the whole file.
        clusters = merge_clusters(read_bed(stream, path), distance, path)
        for chrom, start, end in clusters:
            sys.stdout.write(f"{chrom}\t{start}\t{end}\n")
    finally:
        if stream is not sys.stdin:
            stream.close()
    return 0


class Index:
    """The -b file, in memory, grouped by chromosome and searchable by start.

    -b intervals are stored widened: a zero-length feature is [x-1, x+1) here,
    because that is what bedtools tests against and what it reports back.

    Each interval keeps its line number in -b, because bedtools reports hits in
    -b file order, not in coordinate order. Sorting the hits would look tidier
    and would be wrong.
    """

    def __init__(self) -> None:
        self.starts: dict[str, list[int]] = {}
        self.ends: dict[str, list[int]] = {}
        self.orders: dict[str, list[int]] = {}
        self.max_ends: dict[str, list[int]] = {}

    @classmethod
    def load(cls, path: str) -> "Index":
        index = cls()
        by_chrom: dict[str, list[tuple[int, int, int]]] = {}
        with open_input(path) as stream:
            for order, record in enumerate(read_bed(stream, path)):
                start, end = widen_if_empty(record.start, record.end)
                if start < 0:
                    # Oracle behaviour, and it is a crash: widening chr2 0 0 to
                    # -1 makes bedtools die with "Received illegal bin number -1
                    # from getBin call", exit 1, nothing on stdout. Reproduced
                    # rather than fixed -- see `intersect b a` in the golden suite.
                    raise BedError(
                        f"{path}: {record.chrom} {record.start} {record.end} widens "
                        f"to a negative coordinate, which bedtools cannot index"
                    )
                by_chrom.setdefault(record.chrom, []).append((start, end, order))

        for chrom, intervals in by_chrom.items():
            intervals.sort()
            index.starts[chrom] = [s for s, _, _ in intervals]
            index.ends[chrom] = [e for _, e, _ in intervals]
            index.orders[chrom] = [o for _, _, o in intervals]
            running = []
            highest = 0
            for _, end, _ in intervals:
                highest = max(highest, end)
                running.append(highest)
            index.max_ends[chrom] = running
        return index

    def hits(self, chrom: str, start: int, end: int) -> list[tuple[int, int]]:
        """Widened -b intervals overlapping [start, end), in -b file order."""
        starts = self.starts.get(chrom)
        if starts is None:
            return []
        ends, orders = self.ends[chrom], self.orders[chrom]
        max_ends = self.max_ends[chrom]
        found = []
        # Everything at or past `end` is too far right; walk left from there and
        # stop as soon as no earlier interval can reach back to `start`.
        for i in range(bisect_left(starts, end) - 1, -1, -1):
            if max_ends[i] <= start:
                break
            if ends[i] > start:
                found.append((orders[i], starts[i], ends[i]))
        found.sort()
        return [(start, end) for _, start, end in found]


def cmd_intersect(argv: list[str]) -> int:
    """intersect -a <file|-> -b <file> [-u|-v|-wa]

    -a streams and keeps its input order; -b is held in memory. The overlap
    test widens zero-length features on both sides, but the region reported by
    the default mode uses -a's original coordinates against -b's widened ones:
    intersecting chr1 100 200 with chr1 150 150 prints chr1 149 151.
    """
    a_path = b_path = None
    modes = []
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "-a":
            a_path = take_value(args, "intersect: -a")
        elif arg == "-b":
            b_path = take_value(args, "intersect: -b")
        elif arg in ("-u", "-v", "-wa"):
            modes.append(arg)
        else:
            raise UsageError(f"intersect: unrecognized argument: {arg}")
    if a_path is None or b_path is None:
        raise UsageError("intersect: -a and -b are both required")
    if len(modes) > 1:
        raise UsageError(f"intersect: {' and '.join(modes)} are mutually exclusive")
    if b_path == "-":
        raise UsageError("intersect: -b must be a real file, not stdin")
    mode = modes[0] if modes else None

    index = Index.load(b_path)

    stream = open_input(a_path)
    try:
        for record in read_bed(stream, a_path):
            query_start, query_end = widen_if_empty(record.start, record.end)
            hits = index.hits(record.chrom, query_start, query_end)

            if mode == "-v":
                if not hits:
                    sys.stdout.write(record.line + "\n")
                continue
            if mode == "-u":
                if hits:
                    sys.stdout.write(record.line + "\n")
                continue
            if mode == "-wa":
                for _ in hits:
                    sys.stdout.write(record.line + "\n")
                continue

            # Default: the shared region, carrying -a's trailing columns.
            trailing = record.line.split("\t")[3:]
            for hit_start, hit_end in hits:
                start = max(record.start, hit_start)
                end = min(record.end, hit_end)
                columns = [record.chrom, str(start), str(end), *trailing]
                sys.stdout.write("\t".join(columns) + "\n")
    finally:
        if stream is not sys.stdin:
            stream.close()
    return 0


COMMANDS = {"sort": cmd_sort, "merge": cmd_merge, "intersect": cmd_intersect}


def main(argv: list[str]) -> int:
    if not argv:
        # Usage goes to stderr: stdout is data and gets piped.
        sys.stderr.write(USAGE)
        return 2

    if argv[0] in ("--version", "-version"):
        print(f"mytools {VERSION}")
        return 0

    if argv[0] in ("--help", "-h"):
        sys.stdout.write(USAGE)
        return 0

    if argv[0] in COMMANDS:
        try:
            return COMMANDS[argv[0]](argv[1:])
        except BedError as exc:
            sys.stderr.write(f"mytools: {exc}\n")
            return 1
        except UsageError as exc:
            sys.stderr.write(f"mytools: {exc}\n")
            return 2
        except BrokenPipeError:
            # Downstream closed the pipe (`| head`). Not our error.
            sys.stderr.close()
            return 0

    sys.stderr.write(f"mytools: unknown subcommand: {argv[0]}\n")
    sys.stderr.write(USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
